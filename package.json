{
  "name": "dsh-health-management",
  "version": "1.4.0",
  "description": "Health management tracker for DeepSeek Harness: family metrics plus management goals (metabolic syndrome management and a 12-week lean-muscle season), a copyable visit summary, meal photos that can be estimated by a vision model, and Little Muscle King, a draggable floating health buddy with configurable reminders in DSH Settings. Records and descriptive statistics only; never diagnosis, training, nutrition or medication advice.",
  "type": "module",
  "license": "MIT",
  "author": "hebin-cl",
  "icon": "./assets/icon-180.png",
  "homepage": "https://github.com/hebin-cl/dsh-health-management#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hebin-cl/dsh-health-management.git"
  },
  "bugs": {
    "url": "https://github.com/hebin-cl/dsh-health-management/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "health",
    "health-management",
    "family-health",
    "fitness",
    "metabolic",
    "lean-muscle",
    "body-composition",
    "goals",
    "photos",
    "meal",
    "floating-widget",
    "reminders"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "check": "node scripts/check.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/*.webp",
    "assets/*.png",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
